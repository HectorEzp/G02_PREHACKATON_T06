<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_inscritos_evento" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="ID_EVENTO" class="java.lang.Integer"><defaultValueExpression><![CDATA[0]]></defaultValueExpression></parameter>
	<queryString><![CDATA[SELECT e.nombre AS evento, DATE_FORMAT(e.fecha, '%d/%m/%Y %H:%i') AS fecha_evento, e.lugar, i.id_inscripcion, CONCAT(p.apellidos, ', ', p.nombres) AS participante, p.dni, p.institucion, DATE_FORMAT(i.fecha_inscripcion, '%d/%m/%Y %H:%i') AS fecha_insc, i.estado FROM inscripciones i INNER JOIN eventos e ON e.id_evento = i.id_evento INNER JOIN participantes p ON p.id_participante = i.id_participante WHERE ($P{ID_EVENTO} = 0 OR e.id_evento = $P{ID_EVENTO}) ORDER BY e.fecha DESC, e.nombre, p.apellidos, p.nombres]]></queryString>
	<field name="evento" class="java.lang.String"/>
	<field name="fecha_evento" class="java.lang.String"/>
	<field name="lugar" class="java.lang.String"/>
	<field name="id_inscripcion" class="java.lang.Integer"/>
	<field name="participante" class="java.lang.String"/>
	<field name="dni" class="java.lang.String"/>
	<field name="institucion" class="java.lang.String"/>
	<field name="fecha_insc" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<group name="grpEvento">
		<groupExpression><![CDATA[$F{evento}]]></groupExpression>
		<groupHeader><band height="26" splitType="Prevent"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" mode="Opaque" backcolor="#DFF0FC" forecolor="#075985" x="0" y="2" width="802" height="22"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Evento: " + $F{evento} + "   |   " + $F{fecha_evento} + "   |   " + $F{lugar}]]></textFieldExpression></textField></band></groupHeader>
		<groupFooter><band height="26"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="2" width="802" height="20"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Subtotal del grupo: " + $V{grpEvento_COUNT}]]></textFieldExpression></textField></band></groupFooter>
	</group>
	<title><band height="62"><staticText><reportElement x="0" y="4" width="802" height="30"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement><text><![CDATA[Inscritos por Evento]]></text></staticText><textField><reportElement x="0" y="36" width="802" height="18" forecolor="#64748B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date()) + "   |   " + ($P{ID_EVENTO}.intValue() == 0 ? "Todos los eventos" : "Evento N° " + $P{ID_EVENTO})]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="24"><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="0" y="0" width="40" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[N°]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="40" y="0" width="220" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Participante]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="260" y="0" width="80" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[DNI]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="340" y="0" width="220" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Institución]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="560" y="0" width="130" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Fecha inscripción]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="690" y="0" width="112" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText></band></columnHeader>
	<detail><band height="22"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="40" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{id_inscripcion}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="40" y="0" width="220" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{participante}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="260" y="0" width="80" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{dni}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="340" y="0" width="220" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{institucion}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="560" y="0" width="130" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha_insc}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="690" y="0" width="112" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField></band></detail>
	<pageFooter><band height="24"><textField><reportElement x="0" y="4" width="802" height="16" forecolor="#64748B"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Sistema de Gestión de Eventos y Conferencias  |  Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
	<summary><band height="30"><textField><reportElement x="0" y="8" width="802" height="18"/><textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de inscritos: " + $V{REPORT_COUNT}]]></textFieldExpression></textField></band></summary>
</jasperReport>
