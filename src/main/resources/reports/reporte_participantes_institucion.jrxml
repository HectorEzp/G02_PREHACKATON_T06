<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte_participantes_institucion" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="INSTITUCION" class="java.lang.String"><defaultValueExpression><![CDATA["Todas"]]></defaultValueExpression></parameter>
	<queryString><![CDATA[SELECT institucion, id_participante, CONCAT(apellidos, ', ', nombres) AS nombre_completo, dni, correo, telefono FROM participantes WHERE ($P{INSTITUCION} = 'Todas' OR institucion = $P{INSTITUCION}) ORDER BY institucion, apellidos, nombres]]></queryString>
	<field name="institucion" class="java.lang.String"/>
	<field name="id_participante" class="java.lang.Integer"/>
	<field name="nombre_completo" class="java.lang.String"/>
	<field name="dni" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<group name="grpInstitucion">
		<groupExpression><![CDATA[$F{institucion}]]></groupExpression>
		<groupHeader><band height="26" splitType="Prevent"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" mode="Opaque" backcolor="#DFF0FC" forecolor="#075985" x="0" y="2" width="555" height="22"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Institución: " + $F{institucion}]]></textFieldExpression></textField></band></groupHeader>
		<groupFooter><band height="26"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="2" width="555" height="20"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Subtotal del grupo: " + $V{grpInstitucion_COUNT}]]></textFieldExpression></textField></band></groupFooter>
	</group>
	<title><band height="62"><staticText><reportElement x="0" y="4" width="555" height="30"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="20" isBold="true"/></textElement><text><![CDATA[Participantes por Institución]]></text></staticText><textField><reportElement x="0" y="36" width="555" height="18" forecolor="#64748B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="10"/></textElement><textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date()) + "   |   Institución: " + $P{INSTITUCION}]]></textFieldExpression></textField></band></title>
	<columnHeader><band height="24"><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="0" y="0" width="40" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[ID]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="40" y="0" width="175" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Participante]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="215" y="0" width="70" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[DNI]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="285" y="0" width="180" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Correo]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#0B6BA8" forecolor="#FFFFFF" x="465" y="0" width="90" height="24"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="true"/></textElement><text><![CDATA[Teléfono]]></text></staticText></band></columnHeader>
	<detail><band height="22"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="40" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{id_participante}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="40" y="0" width="175" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{nombre_completo}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="215" y="0" width="70" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{dni}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="285" y="0" width="180" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{correo}]]></textFieldExpression></textField><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="465" y="0" width="90" height="22"/><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#CBD5E1"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression></textField></band></detail>
	<pageFooter><band height="24"><textField><reportElement x="0" y="4" width="555" height="16" forecolor="#64748B"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Sistema de Gestión de Eventos y Conferencias  |  Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
	<summary><band height="30"><textField><reportElement x="0" y="8" width="555" height="18"/><textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de participantes: " + $V{REPORT_COUNT}]]></textFieldExpression></textField></band></summary>
</jasperReport>
