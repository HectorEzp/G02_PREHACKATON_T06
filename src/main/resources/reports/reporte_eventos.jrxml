	<pageFooter><band height="24"><textField><reportElement x="0" y="4" width="802" height="16" forecolor="#64748B"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Sistema de Gestión de Eventos y Conferencias  |  Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
	<summary><band height="30"><textField><reportElement x="0" y="8" width="802" height="18"/><textElement textAlignment="Right"><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de eventos: " + $V{REPORT_COUNT}]]></textFieldExpression></textField></band></summary>
