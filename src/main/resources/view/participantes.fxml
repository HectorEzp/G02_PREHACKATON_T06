<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color:#F4F8FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.prehackaton.eventos.controller.ParticipanteController">
   <top>
      <VBox style="-fx-padding:18 20 6 20; -fx-spacing:2;" >
         <Label style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#075985;" text="Gestión de Participantes" />
         <Label style="-fx-text-fill:#64748B; -fx-font-size:13px;" text="Padroniza la información de asistentes e instituciones." />
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="10.0" top="12.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, DNI, correo o institución…" HBox.hgrow="ALWAYS" />
            <Button onAction="#onRefrescar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#E2E8F0; -fx-text-fill:#334155;" text="↺ Actualizar" />
            <Button onAction="#onReporte" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#0F766E; -fx-text-fill:white;" text="▤ Reporte" />
         </HBox>
         <TableView fx:id="tblParticipantes" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId" maxWidth="60.0" minWidth="45.0" prefWidth="50.0" text="ID" />
               <TableColumn fx:id="colNombres" prefWidth="130.0" text="Nombres" />
               <TableColumn fx:id="colApellidos" prefWidth="130.0" text="Apellidos" />
               <TableColumn fx:id="colDni" prefWidth="85.0" text="DNI" />
               <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo" />
               <TableColumn fx:id="colTelefono" prefWidth="90.0" text="Teléfono" />
               <TableColumn fx:id="colInstitucion" prefWidth="170.0" text="Institución" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color:white; -fx-padding:18; -fx-border-color:#E2E8F0; -fx-border-width:0 0 0 1;" >
         <Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#075985;" text="Datos del participante" />
         <GridPane hgap="8.0" vgap="8.0">
            <columnConstraints>
               <ColumnConstraints minWidth="80.0" prefWidth="90.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="Nombres *" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombres" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Apellidos *" GridPane.rowIndex="1" />
            <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="DNI *" GridPane.rowIndex="2" />
            <TextField fx:id="txtDni" promptText="8 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Correo *" GridPane.rowIndex="3" />
            <TextField fx:id="txtCorreo" promptText="usuario@dominio.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Teléfono" GridPane.rowIndex="4" />
            <TextField fx:id="txtTelefono" promptText="9 dígitos (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Institución *" GridPane.rowIndex="5" />
            <TextField fx:id="txtInstitucion" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </GridPane>
         <HBox spacing="8.0">
            <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#onGuardar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#0B6BA8; -fx-text-fill:white;" text="✚ Guardar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnActualizar" maxWidth="Infinity" onAction="#onActualizar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#F59E0B; -fx-text-fill:white;" text="✎ Actualizar" HBox.hgrow="ALWAYS" />
         </HBox>
         <HBox spacing="8.0">
            <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#onEliminar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#DC2626; -fx-text-fill:white;" text="✖ Eliminar" HBox.hgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLimpiar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#E2E8F0; -fx-text-fill:#334155;" text="↺ Limpiar" HBox.hgrow="ALWAYS" />
         </HBox>
         <Label style="-fx-text-fill:#94A3B8; -fx-font-size:11px;" text="* Campos obligatorios. Seleccione una fila para editarla." wrapText="true" />
      </VBox>
   </right>
</BorderPane>
