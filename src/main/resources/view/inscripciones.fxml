<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color:#F4F8FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.prehackaton.eventos.controller.InscripcionController">
   <top>
      <VBox style="-fx-padding:18 20 6 20; -fx-spacing:2;" >
         <Label style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:#075985;" text="Gestión de Inscripciones" />
         <Label style="-fx-text-fill:#64748B; -fx-font-size:13px;" text="Registra inscripciones relacionando evento y asistente." />
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="10.0" top="12.0" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="txtBuscar" promptText="Buscar por evento, participante, DNI o estado…" HBox.hgrow="ALWAYS" />
            <Button onAction="#onRefrescar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#E2E8F0; -fx-text-fill:#334155;" text="↺ Actualizar" />
            <Button onAction="#onReporte" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#0F766E; -fx-text-fill:white;" text="▤ Reporte" />
         </HBox>
         <TableView fx:id="tblInscripciones" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId" maxWidth="60.0" minWidth="45.0" prefWidth="50.0" text="ID" />
               <TableColumn fx:id="colEvento" prefWidth="220.0" text="Evento" />
               <TableColumn fx:id="colParticipante" prefWidth="180.0" text="Participante" />
               <TableColumn fx:id="colDni" prefWidth="85.0" text="DNI" />
               <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha inscripción" />
               <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color:white; -fx-padding:18; -fx-border-color:#E2E8F0; -fx-border-width:0 0 0 1;" >
         <Label style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#075985;" text="Datos de la inscripción" />
         <GridPane hgap="8.0" vgap="8.0">
            <columnConstraints>
               <ColumnConstraints minWidth="80.0" prefWidth="90.0" />
               <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <Label text="Evento *" GridPane.rowIndex="0" />
            <ComboBox fx:id="cmbEvento" maxWidth="Infinity" promptText="Seleccione evento" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Participante *" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbParticipante" maxWidth="Infinity" promptText="Seleccione participante" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Fecha *" GridPane.rowIndex="2" />
            <DatePicker fx:id="dpFecha" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Estado *" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </GridPane>
         <HBox spacing="8.0">
            <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#onGuardar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#0B6BA8; -fx-text-fill:white;" text="✚ Guardar" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnActualizar" maxWidth="Infinity" onAction="#onActualizar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#F59E0B; -fx-text-fill:white;" text="✎ Actualizar" HBox.hgrow="ALWAYS" />
         </HBox>
         <HBox spacing="8.0">
            <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#onEliminar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#DC2626; -fx-text-fill:white;" text="✖ Eliminar" HBox.hgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLimpiar" style="-fx-background-radius:7; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:8 14; -fx-background-color:#E2E8F0; -fx-text-fill:#334155;" text="↺ Limpiar" HBox.hgrow="ALWAYS" />
         </HBox>
         <Label style="-fx-text-fill:#94A3B8; -fx-font-size:11px;" text="* Campos obligatorios. No se admiten inscripciones nuevas en eventos finalizados o cancelados." wrapText="true" />
      </VBox>
   </right>
</BorderPane>
